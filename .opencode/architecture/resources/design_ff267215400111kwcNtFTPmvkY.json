    {
      "id": "fix_agent_edits_refresh_scope",
      "text": "Scope: selected-resource refresh guard\nTouched architecture-panel.tsx and sync-events.ts. The panel now passes localDirty() instead of dirty(), so local pending UI work is still protected while external/agent updates can refetch immediately.",
      "tags": [
        "change-target",
        "data",
        "implemented"
      ],
      "layout": {
        "position": {
