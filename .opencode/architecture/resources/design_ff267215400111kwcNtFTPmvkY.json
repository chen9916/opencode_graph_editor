  "nodes": [
    {
      "id": "canvas_editor",
      "text": "Canvas editor\nReact Flow renders nodes, wires, selection, outline/filter UI, context menus, viewport behavior, and keyboard commands.",
      "tags": [
        "canvas",
        "editing"
      ],
      "layout": {
        "position": {
          "x": 1080,
          "y": 0
        }
      }
    },
    {
      "id": "entry_points",
      "text": "Entry points\nHeader button, side-panel tab, command palette, and @graph mentions open or reference the Graph editor.",
      "tags": [
        "entry"
      ],
      "layout": {
        "position": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": "live_sync",
      "text": "Live sync\nRuntime view and sync helpers merge saved snapshots, live instances, pending overlays, dirty reasons, conflicts, and server events.",
      "tags": [
        "sync"
      ],
      "layout": {
        "position": {
          "x": 360,
          "y": 240
        }
      }
    },
    {
      "id": "operation_flow",
      "text": "Operation flow\nUI gestures become typed operations, enter local history/journal, call the architecture API, and save through the managed resource boundary.",
      "tags": [
        "editing",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 720,
          "y": 240
        }
      }
    },
    {
      "id": "properties_panel",
      "text": "Properties panel\nThe right inspector edits graph name, node text/tags, tag colors, edge sides/styles, and shows collapsed sync debug info.",
      "tags": [
        "editing"
      ],
      "layout": {
        "position": {
          "x": 1080,
          "y": 240
        }
      }
    },
    {
      "id": "react_bridge",
      "text": "React bridge\nArchitectureIsland lazy-loads React, React DOM, React Flow, and the canvas editor only after the Graph tab is opened.",
      "tags": [
        "canvas",
        "shell"
      ],
      "layout": {
        "position": {
          "x": 720,
          "y": 0
        }
      }
    },
    {
      "id": "recent_improvements",
      "text": "Recent implemented UX work\nAgent edits refresh automatically; edited nodes can be highlighted; dangling connections can create nodes; crowded wire endpoints are easier to read.",
      "tags": [
        "canvas",
        "implemented"
      ],
      "layout": {
        "position": {
          "x": 720,
          "y": 480
        }
      }
    },
    {
      "id": "solid_shell",
      "text": "Solid shell\nArchitecturePanel owns resource switching, loading states, file actions, save/reload, persisted state, and editor props.",
      "tags": [
        "shell"
      ],
      "layout": {
        "position": {
          "x": 360,
