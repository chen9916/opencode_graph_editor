  "nodes": [
    {
      "id": "node_graph3_instance_api",
      "text": "Architecture HTTP/SDK instance API\nThe app uses generated Server SDK calls for list/get resources plus get, patch, commit, and reload instance endpoints. Patch updates only the live instance; commit writes the expected live instance to the saved resource file.",
      "tags": [
        "api",
        "implemented",
        "server",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -320,
          "y": -160
        }
      }
    },
    {
      "id": "node_graph3_journal_sync",
      "text": "Persistent local journal + synchronizer\nEditor commits persist pendingOverlays and viewports per workspace/resource. A serialized synchronizer turns the desired local resource into patch operations against /instance, bridging unacknowledged UI edits and recovery.",
      "tags": [
        "app",
        "implemented",
        "state",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -760,
          "y": 0
        }
      }
    },
    {
      "id": "node_graph3_module_ai_access",
      "text": "MODULE: AI graph workspace access\nResponsibility: expose bounded authored graph context and safe native graph_* operations. Agents can explain, edit, validate, route, layout, save, or reload managed resources without treating graph JSON as source-code truth.",
      "tags": [
        "ai",
        "core",
        "module",
        "responsibility"
      ],
      "layout": {
        "position": {
          "x": 1000,
          "y": -580
        }
      }
    },
    {
      "id": "node_graph3_module_api_boundary",
      "text": "MODULE: HTTP/SDK instance boundary\nResponsibility: keep the app/server contract explicit. Generated SDK calls list/get saved resources and operate on live instances through patch, commit, reload, and discard-style lifecycle endpoints.",
      "tags": [
        "api",
        "boundary",
        "module",
        "responsibility",
        "server"
      ],
      "layout": {
        "position": {
          "x": -320,
          "y": -580
        }
      }
    },
    {
      "id": "node_graph3_module_core_runtime",
      "text": "MODULE: Core live-instance runtime\nResponsibility: hold the authoritative per-location working copy before Save. Owns base digest/revision checks, live patch application, AI/editor convergence, and conflict-safe commit or discard semantics.",
      "tags": [
        "core",
        "module",
        "responsibility",
        "runtime",
        "state"
      ],
      "layout": {
        "position": {
          "x": 120,
          "y": -580
        }
      }
    },
    {
      "id": "node_graph3_module_editor_surface",
      "text": "MODULE: Editor surface + user actions\nResponsibility: render the graph and capture human edits. Owns canvas interaction, inline text/tag changes, wire route controls, and Save/Reload commands. It should not own persistence or backend conflict rules.",
      "tags": [
        "app",
        "editor",
        "module",
        "responsibility",
        "ui"
      ],
      "layout": {
        "position": {
          "x": -1200,
          "y": -580
        }
      }
    },
    {
      "id": "node_graph3_module_local_state_sync",
      "text": "MODULE: Local projection + journaled sync\nResponsibility: turn saved/live/backend state plus unsaved local overlays into the visible resource. Owns dirty state, viewport/pending overlay recovery, serialized patching, and editor-to-instance synchronization.",
      "tags": [
        "app",
        "module",
        "responsibility",
        "state",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -760,
          "y": -580
        }
      }
    },
    {
      "id": "node_graph3_module_storage_events",
      "text": "MODULE: Durable storage + events\nResponsibility: persist versioned graph resources and broadcast lifecycle updates. Disk is changed only by explicit create/reset/remove/duplicate/commit flows; events notify open views when saved or live state changes.",
      "tags": [
        "event",
        "module",
        "responsibility",
        "storage"
      ],
      "layout": {
        "position": {
          "x": 560,
          "y": -580
        }
      }
    },
    {
      "id": "node_msom3b92",
      "text": "On-screen React Flow editor\nRenders the visible graph from the selected resource snapshot plus any live-instance and local pending overlay. Canvas edits, inline text, tags, positions, and wire controls update local editor history immediately.",
      "tags": [
        "app",
        "editor",
        "implemented"
      ],
      "layout": {
        "position": {
          "x": -1200,
          "y": -300
        }
      }
    },
    {
      "id": "node_msom3mru",
      "text": "Save button\nDispatches the editor save command. The panel invalidates queued sync, re-observes the authoritative instance, patches remaining desired edits, commits the live instance to disk, then clears the local overlay and live cache.",
      "tags": [
        "app",
        "implemented",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -1380,
          "y": 0
        }
      }
    },
    {
      "id": "node_msom3rhd",
      "text": "Reload button\nIf the editor is dirty it asks for confirmation. Reload invalidates local synchronization, discards the backend live instance in favor of the saved snapshot, clears the local pending overlay, and refreshes the projection.",
      "tags": [
        "app",
        "implemented",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -1020,
          "y": 0
        }
      }
    },
    {
      "id": "node_msom4jwu",
      "text": "Chat agent with Graph context\nA named @Graph mention gives the agent bounded managed-resource context. The graph is treated as authored design/task context, not a source file or proof of implementation.",
      "tags": [
        "ai",
        "implemented"
      ],
      "layout": {
        "position": {
          "x": 1000,
          "y": -300
        }
      }
    },
    {
      "id": "node_msom4pdn",
      "text": "Backend per-resource live instance\nLocation-scoped in-memory entry stores baseRevision, baseDigest, and the patched resource. Editor patches and AI graph_* tools share this same live instance until Save commits it or Reload discards it.",
      "tags": [
        "core",
        "implemented",
        "state"
      ],
      "layout": {
        "position": {
          "x": 120,
          "y": -160
        }
      }
    },
    {
      "id": "node_msom57qc",
      "text": "Native graph_* tools\nAI lists, queries, validates, edits, lays out, routes, saves, or reloads managed Graph resources through the ArchitectureGraph service with permissions. Tools patch the live instance; graph_save_resource is the explicit disk save.",
      "tags": [
        "ai",
        "core",
        "implemented"
      ],
      "layout": {
        "position": {
          "x": 1000,
          "y": 0
        }
      }
    },
    {
      "id": "node_msom5lry",
      "text": "Saved graph resource on disk\nDurable version-2 JSON lives under .opencode/architecture/resources/<resource-id>.json. It stores node text, free-form tags, tag colors, positions, and edges with handles/style. It is written by create/reset/remove/duplicate or live-instance commit.",
      "tags": [
        "implemented",
        "storage"
      ],
      "layout": {
        "position": {
          "x": 560,
          "y": -260
        }
      }
    },
    {
      "id": "node_msom6mje",
      "text": "Graph resource events\nThe core service publishes resource-updated, resource-removed, instance-updated, and instance-discarded events. These notify open editor views when a live instance changes or is cleared.",
      "tags": [
        "core",
        "event",
        "implemented"
      ],
      "layout": {
        "position": {
          "x": 560,
          "y": 60
        }
      }
    },
    {
      "id": "node_msom74aa",
      "text": "Editor cache and visible projection\nThe panel adopts/refetches snapshots from events, reconciles saved state, backend live instance, and persisted pending overlay, then passes the resolved resource into the lazy React editor. This is the visible user update path.",
      "tags": [
        "app",
        "implemented",
        "state"
      ],
      "layout": {
        "position": {
          "x": -760,
          "y": -300
        }
      }
    }
  ],
