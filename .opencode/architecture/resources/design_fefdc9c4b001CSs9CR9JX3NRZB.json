  "nodes": [
    {
      "id": "node_current_backend_live_draft",
      "text": "Backend live graph draft\nShared in-memory managed draft for the open resource. UI sync and AI graph_* edits meet here; draft events let the editor adopt/refetch changes before Save.",
      "tags": [
        "core",
        "current-system",
        "event",
        "live-draft",
        "state"
      ],
      "layout": {
        "position": {
          "x": 920,
          "y": 40
        }
      }
    },
    {
      "id": "node_current_client_sdk",
      "text": "Local Graph bridge\nUI and Graph tools call the local backend boundary. No external networking mental model, no Graph availability probe, and no raw JSON edits from the renderer.",
      "tags": [
        "app",
        "current-system",
        "local",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 320,
          "y": 40
        }
      }
    },
    {
      "id": "node_current_core_service",
      "text": "Core architecture service\nApplies UI and AI graph patches to managed live drafts, checks revisions/digests, validates operations, publishes draft/saved events, and commits Save to storage.",
      "tags": [
        "core",
        "current-system",
        "local",
        "server"
      ],
      "layout": {
        "position": {
          "x": 620,
          "y": 40
        }
      }
    },
    {
      "id": "node_current_editor_ux",
      "text": "Editor UX controls\nOutline + Properties panels, filters, context menus, undo/redo, export, loading/error/empty states.",
      "tags": [
        "app",
        "current-system",
        "editor"
      ],
      "layout": {
        "position": {
          "x": -600,
          "y": 300
        }
      }
    },
    {
      "id": "node_current_guardrail",
      "text": "Custom product boundary\nThis Graph feature is for this local OpenCode build: a shared communication workspace, not a public compatibility layer or dependency scanner.",
      "tags": [
        "current-system",
        "custom-build",
        "guardrail",
        "model"
      ],
      "layout": {
        "position": {
          "x": 620,
          "y": -360
        }
      }
    },
    {
      "id": "node_current_journal",
      "text": "Local journal + viewport\nKeeps the canvas responsive and crash/reload recoverable. Manual UI edits are also synchronized into the backend live draft.",
      "tags": [
        "current-system",
        "editor",
        "state",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -280,
          "y": 300
        }
      }
    },
    {
      "id": "node_current_mention_filtering",
      "text": "@Graph mention + media filtering\nMentions stay visible in chat, while managed graph JSON is omitted from provider file/media parts.",
      "tags": [
        "ai",
        "context",
        "current-system"
      ],
      "layout": {
        "position": {
          "x": 20,
          "y": -320
        }
      }
    },
    {
      "id": "node_current_react_editor",
      "text": "Lazy React Flow Graph editor\nThe UI you see: resource switch/create/delete, text nodes, free-form tags, drag persistence, selected-node/wire highlighting.",
      "tags": [
        "app",
        "current-system",
        "editor"
      ],
      "layout": {
        "position": {
          "x": -600,
          "y": 40
        }
      }
    },
    {
      "id": "node_current_resource_model",
      "text": "Resource model\nMany named resources; nodes are text/tags/positions; edges store source/target handles/style; status is just a tag; no stored cross-resource refs.",
      "tags": [
        "current-system",
        "model"
      ],
      "layout": {
        "position": {
          "x": 920,
          "y": -180
        }
      }
    },
    {
      "id": "node_current_schema",
      "text": "Schema layer\nValidates graph resources and edit inputs: nodes, tags, positions, handles, styles, revisions, digests, and operation shapes.",
      "tags": [
        "current-system",
        "model",
        "schema"
      ],
      "layout": {
        "position": {
          "x": 620,
          "y": -180
        }
      }
    },
    {
      "id": "node_current_session_surface",
      "text": "Session surfaces\nCustom local build assumes Graph is available: desktop side panel + mobile Graph tab, no /api/architecture/resource capability probe.",
      "tags": [
        "app",
        "current-system",
        "custom-build",
        "entrypoint"
      ],
      "layout": {
        "position": {
          "x": -920,
          "y": 300
        }
      }
    },
    {
      "id": "node_current_system_context",
      "text": "Bounded dynamic System Context\nAI sees selected/named Graph summaries and exact IDs/aliases from managed resources, not raw graph JSON media.",
      "tags": [
        "ai",
        "context",
        "current-system"
      ],
      "layout": {
        "position": {
          "x": -280,
          "y": -320
        }
      }
    },
    {
      "id": "node_current_wire_model",
      "text": "Wire model + routing UI\nExplicit top/right/bottom/left endpoints and rectangular/curved/straight routes persist for users and AI to inspect/edit.",
      "tags": [
        "current-system",
        "editor",
        "model"
      ],
      "layout": {
        "position": {
          "x": -280,
          "y": -160
        }
      }
    },
    {
      "id": "node_msodnwlx",
      "text": "Saved resource JSON\nDisk storage under .opencode/architecture/resources/<resource-id>.json. This changes only through managed Save, not direct UI/AI file edits.",
      "tags": [
        "current-system",
        "model",
        "storage"
      ],
      "layout": {
        "position": {
          "x": 1220,
          "y": 40
        }
      }
    },
    {
      "id": "node_msodobgy",
      "text": "AI assistant + Graph context\nUses @Graph mentions and bounded resource summaries; no dedicated in-editor AI button.",
      "tags": [
        "ai",
        "current-system",
        "entrypoint"
      ],
      "layout": {
        "position": {
          "x": -943.77590850591,
          "y": -325.9439771264774
        }
      }
    },
    {
      "id": "node_msodojhd",
      "text": "Editor-visible graph state\nReact Flow projection from saved snapshot + backend live draft + local journal. AI/tool draft events can update what you see before disk Save.",
      "tags": [
        "current-system",
        "editor",
        "live-draft",
        "state"
      ],
      "layout": {
        "position": {
          "x": -280,
          "y": 40
        }
      }
    },
    {
      "id": "node_msodotvs",
      "text": "Native managed graph_* tools\nAI creates/updates nodes, tags, colors, wires, layout, and Save/Reload by patching the managed backend live draft through core services.",
      "tags": [
        "ai",
        "current-system",
        "live-draft",
        "tools"
      ],
      "layout": {
        "position": {
          "x": -600,
          "y": -320
        }
      }
    },
    {
      "id": "node_msodp7k2",
      "text": "Explicit Save boundary\nSave first synchronizes visible editor changes into the live draft, then commits that draft to the saved JSON resource on disk.",
      "tags": [
        "current-system",
        "editor",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 20,
          "y": -80
        }
      }
    },
    {
      "id": "node_msodpc1x",
      "text": "Reload boundary\nReload discards the backend live draft and local journal for this resource, then shows the saved resource again.",
      "tags": [
        "current-system",
        "editor",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 20,
          "y": 160
        }
      }
    },
    {
      "id": "node_msodq6qn",
      "text": "Human manual edits\nCanvas edits, inline text, tags, wire controls, panels, and commands update local UI immediately and sync to the backend live draft.",
      "tags": [
        "current-system",
        "editor",
        "entrypoint",
        "live-draft"
      ],
      "layout": {
        "position": {
          "x": -920,
          "y": 40
        }
      }
    }
  ],
