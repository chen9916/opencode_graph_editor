  "nodes": [
    {
      "id": "node_current_backend_live_instance",
      "text": "Per-resource live instance\nIn-memory resource state keeps the saved base revision/digest. Editor and AI patches share it; instance-updated/discarded events let every view reconcile.",
      "tags": [
        "core",
        "current-system",
        "data",
        "event",
        "live-instance",
        "state"
      ],
      "layout": {
        "position": {
          "x": 450,
          "y": 310
        }
      }
    },
    {
      "id": "node_current_client_sdk",
      "text": "App API bridge\nThe panel calls the current server API through the shared Server SDK. Graph is always enabled in this local build; it does not use the protocol detector or a Graph capability probe.",
      "tags": [
        "app",
        "current-system",
        "local",
        "responsibility",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 0,
          "y": -390
        }
      }
    },
    {
      "id": "node_current_core_service",
      "text": "Core graph service\nLocation-scoped service applies optimistic operations to live instances, locks resource storage, checks revisions/digests, publishes events, and commits an instance only at Save.",
      "tags": [
        "core",
        "current-system",
        "local",
        "responsibility",
        "server"
      ],
      "layout": {
        "position": {
          "x": 450,
          "y": -390
        }
      }
    },
    {
      "id": "node_current_editor_ux",
      "text": "Editor interaction surface\nOutline and Properties start closed; filters, context menus, inline editing, undo/redo, conflict display, export, resource actions, and loading/error/empty states are supported.",
      "tags": [
        "app",
        "current-system",
        "editor",
        "responsibility",
        "visible"
      ],
      "layout": {
        "position": {
          "x": 0,
          "y": -720
        }
      }
    },
    {
      "id": "node_current_guardrail",
      "text": "Product boundary\nGraph is a human-and-AI communication workspace for authored design intent. It is not a dependency scanner, generated source of truth, fixed taxonomy, or automatic implementation model.",
      "tags": [
        "current-system",
        "guardrail",
        "model",
        "responsibility"
      ],
      "layout": {
        "position": {
          "x": -1350,
          "y": -390
        }
      }
    },
    {
      "id": "node_current_journal",
      "text": "Persistent pending overlay + viewport\nUI changes are journaled per workspace/resource and rebased over refreshed saved or live state. The overlay survives reloads without a beforeunload blocker and records visible conflicts.",
      "tags": [
        "current-system",
        "data",
        "editor",
        "indicator",
        "state",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 0,
          "y": 310
        }
      }
    },
    {
      "id": "node_current_mention_filtering",
      "text": "Managed @Graph references\nMentions remain visible to the conversation, but managed Graph JSON is excluded from provider file/media parts in current and legacy message paths (including source.path fallbacks).",
      "tags": [
        "ai",
        "context",
        "current-system",
        "responsibility"
      ],
      "layout": {
        "position": {
          "x": -900,
          "y": -390
        }
      }
    },
    {
      "id": "node_current_react_editor",
      "text": "Lazy React Flow editor\nNamed-resource selection/create/duplicate/delete; editable text and free-form tags; persistent drag positions; multi-selection; node/edge context menus; selection prompts; and custom visible wires.",
      "tags": [
        "app",
        "current-system",
        "editor",
        "responsibility",
        "visible"
      ],
      "layout": {
        "position": {
          "x": -450,
          "y": -720
        }
      }
    },
    {
      "id": "node_current_resource_model",
      "text": "Resource model\nVersion-2 named resources contain text nodes, free-form tags, per-resource tag colors, positions, and directed edges with explicit endpoint sides and route style. Status is only a normal tag; cross-resource refs are not stored.",
      "tags": [
        "current-system",
        "data",
        "model"
      ],
      "layout": {
        "position": {
          "x": 900,
          "y": -40
        }
      }
    },
    {
      "id": "node_current_schema",
      "text": "Shared schema + optimistic operations\nBrowser-safe contracts define resource snapshots, live-instance snapshots, node/tag/position data, connection sides/styles, patches, revision/digest concurrency, and Graph events.",
      "tags": [
        "current-system",
        "data",
        "model",
        "schema"
      ],
      "layout": {
        "position": {
          "x": 450,
          "y": -40
        }
      }
    },
    {
      "id": "node_current_session_surface",
      "text": "Session entry points\nGraph is available through the desktop session side panel and a full mobile tab; the composer hides on mobile Graph. Commands open Graph and invoke Save, Reload, fit, undo/redo, add, delete, and export.",
      "tags": [
        "app",
        "current-system",
        "entrypoint",
        "local",
        "responsibility",
        "visible"
      ],
      "layout": {
        "position": {
          "x": -1350,
          "y": -720
        }
      }
    },
    {
      "id": "node_current_system_context",
      "text": "Bounded dynamic System Context\nThe registered Graph context summarizes managed live resources, exact IDs, aliases, nodes, tags, and wires for AI. It preserves authored meaning rather than treating Graph content as implementation proof.",
      "tags": [
        "ai",
        "context",
        "current-system",
        "responsibility"
      ],
      "layout": {
        "position": {
          "x": -450,
          "y": -390
        }
      }
    },
    {
      "id": "node_current_wire_model",
      "text": "Inspectable wire routing\nEdges persist top/right/bottom/left source and target handles plus rectangular, curved, or straight style. Selected-wire and inspector controls change routing immediately, then journal and synchronize it.",
      "tags": [
        "current-system",
        "editor",
        "model",
        "responsibility",
        "visible"
      ],
      "layout": {
        "position": {
          "x": 450,
          "y": -720
        }
      }
    },
    {
      "id": "node_msodnwlx",
      "text": "Durable resource storage\nVersion-2 JSON lives under .opencode/architecture/resources/<resource-id>.json in the primary worktree. Managed Save writes atomically under process/cross-process locks; reset preserves invalid data as a recovery file.",
      "tags": [
        "current-system",
        "data",
        "model",
        "saved",
        "storage"
      ],
      "layout": {
        "position": {
          "x": 450,
          "y": 660
        }
      }
    },
    {
      "id": "node_msodobgy",
      "text": "AI conversation surface\nUsers bring a resource into chat with @Graph. Context-menu “Ask selection” adds bounded selection context to a chat prompt; there is no separate global in-editor AI workflow.",
      "tags": [
        "ai",
        "current-system",
        "entrypoint",
        "responsibility",
        "visible"
      ],
      "layout": {
        "position": {
          "x": 900,
          "y": -720
        }
      }
    },
    {
      "id": "node_msodojhd",
      "text": "Resolved canvas state\nNot a separate visible renderer: the panel reconciles the backend live instance (or saved snapshot) with any local pending overlay, then passes this data to the lazy React Flow editor to render on screen.",
      "tags": [
        "current-system",
        "data",
        "editor",
        "indicator",
        "live-instance",
        "state"
      ],
      "layout": {
        "position": {
          "x": -450,
          "y": -40
        }
      }
    },
    {
      "id": "node_msodotvs",
      "text": "Native managed graph_* tools\nAI lists, queries, validates, edits, lays out, routes, saves, or reloads managed resources through the same location-scoped live instance as the editor; tools never edit Graph JSON directly.",
      "tags": [
        "ai",
        "current-system",
        "live-instance",
        "responsibility",
        "tools"
      ],
      "layout": {
        "position": {
          "x": 1350,
          "y": -720
        }
      }
    },
    {
      "id": "node_msodp7k2",
      "text": "Explicit Save boundary\nSave invalidates queued sync work, re-observes the authoritative live instance, patches any remaining editor change, then commits that instance to disk and clears the live instance + local overlay.",
      "tags": [
        "current-system",
        "editor",
        "responsibility",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 900,
          "y": -390
        }
      }
    },
    {
      "id": "node_msodpc1x",
      "text": "Explicit Reload / discard boundary\nReload invalidates pending synchronization, discards the backend live instance in favor of its saved snapshot, clears the local overlay, then refreshes the editor projection.",
      "tags": [
        "current-system",
        "editor",
        "reload",
        "responsibility",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 1350,
          "y": -390
        }
      }
    },
    {
      "id": "node_msodq6qn",
      "text": "Human manual edits\nCanvas, inline text, tags, wire controls, panels, and commands update local editor history immediately. The journal persists the pending change while a serialized synchronizer patches the shared live instance.",
      "tags": [
        "current-system",
        "editor",
        "entrypoint",
        "live-instance",
        "responsibility",
        "visible"
      ],
      "layout": {
        "position": {
          "x": -924,
          "y": -712
        }
      }
    }
  ],
