  "nodes": [
    {
      "id": "node_bug_base_identity_cause",
      "text": "Resolved reload cause: stale local layer identity\nThe previous editor reset depended on saved snapshot/base identity. Same-resource Reload now bumps the live instance version so React rebuilds immediately.",
      "tags": [
        "bug",
        "implemented",
        "reload",
        "state"
      ],
      "layout": {
        "position": {
          "x": -230,
          "y": 830
        }
      }
    },
    {
      "id": "node_bug_editor_reset_effect",
      "text": "Implemented reset effect\n`ArchitectureEditor` rebuilds internal React Flow state from `architectureEditorLiveInstanceKey(saved identity + liveInstanceVersion)`, not only from base object identity.",
      "tags": [
        "code",
        "editor",
        "implemented"
      ],
      "layout": {
        "position": {
          "x": 70,
          "y": 830
        }
      }
    },
    {
      "id": "node_bug_fix_editor_dep",
      "text": "Implemented editor fix\n`liveInstanceVersion` is passed through `ArchitecturePanelProps` and included in the reset key, so Reload/Save replaces the visible graph instance even for the same resource.",
      "tags": [
        "code",
        "editor",
        "implemented"
      ],
      "layout": {
        "position": {
          "x": 971.1040895025028,
          "y": 826.6877314924918
        }
      }
    },
    {
      "id": "node_bug_fix_guardrail",
      "text": "Architecture guardrail\nNo page refresh, graph switching, raw JSON reads, or file watcher hacks. UI and AI converge on the backend live graph instance; Save remains the disk boundary.",
      "tags": [
        "guardrail",
        "implemented",
        "live-instance"
      ],
      "layout": {
        "position": {
          "x": 670,
          "y": 1060
        }
      }
    },
    {
      "id": "node_bug_fix_reset_token",
      "text": "Implemented: liveInstanceVersion\nSame-resource reset signal increments after successful Save or Reload so the editor projection replaces its current instance source.",
      "tags": [
        "implemented",
        "live-instance",
        "reload",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 670,
          "y": 830
        }
      }
    },
    {
      "id": "node_bug_fix_tests",
      "text": "Tests\nFocused tests cover same-resource Reload reset, Save/Reload instance version bumps, AI live-instance event adoption, pending-overlay clearing, and undo after backend ack.",
      "tags": [
        "implemented",
        "test"
      ],
      "layout": {
        "position": {
          "x": 1270,
          "y": 830
        }
      }
    },
    {
      "id": "node_bug_reload_panel_path",
      "text": "Reload path: ArchitecturePanel\n`reloadResource()` invalidates synchronization, calls `reloadArchitectureResourceInstance()`, sets saved snapshot cache, clears live instance cache, clears pending overlay, and bumps `liveInstanceVersion`.",
      "tags": [
        "code",
        "implemented",
        "reload",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -550,
          "y": 830
        }
      }
    },
    {
      "id": "node_bug_reload_stale_ui",
      "text": "Bug: Reload does not refresh canvas\nAfter Reload, the Graph UI can keep showing stale local edits until you switch to another graph and back.",
      "tags": [
        "bug",
        "current-system",
        "reload"
      ],
      "layout": {
        "position": {
          "x": -870.0000000000002,
          "y": 830
        }
      }
    },
    {
      "id": "node_bug_switch_back_why",
      "text": "Why switching graphs fixes it\nSwitching resource changes the resource/base identity, so the reset effect finally runs and rebuilds from the saved graph.",
      "tags": [
        "bug",
        "editor",
        "state"
      ],
      "layout": {
        "position": {
          "x": 371.21901364392625,
          "y": 833.6570409317787
        }
      }
    },
    {
      "id": "node_current_backend_live_instance",
      "text": "Backend live graph instance\nShared in-memory managed instance for the open resource. UI patches and AI graph_* edits meet here; instance events let the editor adopt/refetch changes before Save.",
      "tags": [
        "core",
        "current-system",
        "event",
        "live-instance",
        "state"
      ],
      "layout": {
        "position": {
          "x": 1216.234895499401,
          "y": 283.6071103939828
        }
      }
    },
    {
      "id": "node_current_client_sdk",
      "text": "Local Graph bridge\nUI and Graph tools call the local backend boundary. No external networking mental model, no Graph availability probe, and no raw JSON edits from the renderer.",
      "tags": [
        "app",
        "current-system",
        "local",
        "sync"
      ],
      "layout": {
        "position": {
          "x": 379.4836285982597,
          "y": 400.359704614061
        }
      }
    },
    {
      "id": "node_current_core_service",
      "text": "Core architecture service\nApplies UI and AI graph patches to managed live instances, checks revisions/digests, validates operations, publishes instance/saved events, and commits Save to storage.",
      "tags": [
        "core",
        "current-system",
        "local",
        "server"
      ],
      "layout": {
        "position": {
          "x": 815.8080933171055,
          "y": 21.611371024393804
        }
      }
    },
    {
      "id": "node_current_editor_ux",
      "text": "Editor UX controls\nOutline + Properties panels, filters, context menus, undo/redo, export, loading/error/empty states.",
      "tags": [
        "app",
        "current-system",
        "editor"
      ],
      "layout": {
        "position": {
          "x": -775.9245990167188,
          "y": 468.93778924763615
        }
      }
    },
    {
      "id": "node_current_guardrail",
      "text": "Custom product boundary\nThis Graph feature is for this local OpenCode build: a shared communication workspace, not a public compatibility layer or dependency scanner.",
      "tags": [
        "current-system",
        "custom-build",
        "guardrail",
        "model"
      ],
      "layout": {
        "position": {
          "x": 539.6071353823874,
          "y": -548.6771312454173
        }
      }
    },
    {
      "id": "node_current_journal",
      "text": "Local journal + viewport\nKeeps the canvas responsive and crash/reload recoverable. Manual UI edits are synchronized into the backend live graph instance as pending overlays until acknowledged.",
      "tags": [
        "current-system",
        "editor",
        "state",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -428,
          "y": 518
        }
      }
    },
    {
      "id": "node_current_mention_filtering",
      "text": "@Graph mention + media filtering\nMentions stay visible in chat, while managed graph JSON is omitted from provider file/media parts.",
      "tags": [
        "ai",
        "context",
        "current-system"
      ],
      "layout": {
        "position": {
          "x": 20,
          "y": -320
        }
      }
    },
    {
      "id": "node_current_react_editor",
      "text": "Lazy React Flow Graph editor\nThe UI you see: resource switch/create/delete, text nodes, free-form tags, drag persistence, selected-node/wire highlighting.",
      "tags": [
        "app",
        "current-system",
        "editor"
      ],
      "layout": {
        "position": {
          "x": -907.6406707064821,
          "y": 108.84109902405035
        }
      }
    },
    {
      "id": "node_current_resource_model",
      "text": "Resource model\nMany named resources; nodes are text/tags/positions; edges store source/target handles/style; status is just a tag; no stored cross-resource refs.",
      "tags": [
        "current-system",
        "model"
      ],
      "layout": {
        "position": {
          "x": 1276.0255433065704,
          "y": -307.9723151055874
        }
      }
    },
    {
      "id": "node_current_schema",
      "text": "Schema layer\nValidates graph resources and edit inputs: nodes, tags, positions, handles, styles, revisions, digests, and operation shapes.",
      "tags": [
        "current-system",
        "model",
        "schema"
      ],
      "layout": {
        "position": {
          "x": 503.5123798397857,
          "y": -243.98615755279374
        }
      }
    },
    {
      "id": "node_current_session_surface",
      "text": "Session surfaces\nCustom local build assumes Graph is available: desktop side panel + mobile Graph tab, no /api/architecture/resource capability probe.",
      "tags": [
        "app",
        "current-system",
        "custom-build",
        "entrypoint"
      ],
      "layout": {
        "position": {
          "x": -1146.0185955725792,
          "y": 535.7918209949945
        }
      }
    },
    {
      "id": "node_current_system_context",
      "text": "Bounded dynamic System Context\nAI sees selected/named Graph summaries and exact IDs/aliases from managed resources, not raw graph JSON media.",
      "tags": [
        "ai",
        "context",
        "current-system"
      ],
      "layout": {
        "position": {
          "x": -274,
          "y": -540
        }
      }
    },
    {
      "id": "node_current_wire_model",
      "text": "Wire model + routing UI\nExplicit top/right/bottom/left endpoints and rectangular/curved/straight routes persist for users and AI to inspect/edit.",
      "tags": [
        "current-system",
        "editor",
        "model"
      ],
      "layout": {
        "position": {
          "x": -493.8868982368038,
          "y": -176.05089137126743
        }
      }
    },
    {
      "id": "node_msodnwlx",
      "text": "Saved resource JSON\nDisk storage under .opencode/architecture/resources/<resource-id>.json. This changes only through managed Save, not direct UI/AI file edits.",
      "tags": [
        "current-system",
        "model",
        "storage"
      ],
      "layout": {
        "position": {
          "x": 1449.3569125815848,
          "y": -59.12522107006524
        }
      }
    },
    {
      "id": "node_msodobgy",
      "text": "AI assistant + Graph context\nUses @Graph mentions and bounded resource summaries; no dedicated in-editor AI button.",
      "tags": [
        "ai",
        "current-system",
        "entrypoint"
      ],
      "layout": {
        "position": {
          "x": -943.77590850591,
          "y": -325.9439771264774
        }
      }
    },
    {
      "id": "node_msodojhd",
      "text": "Editor-visible graph projection\nReact Flow projection from the backend live graph instance when present, otherwise saved snapshot. Local pending overlay only bridges unacknowledged UI edits.",
      "tags": [
        "current-system",
        "editor",
        "live-instance",
        "state"
      ],
      "layout": {
        "position": {
          "x": -501.7706212191107,
          "y": 63.14995455345611
        }
      }
    },
    {
      "id": "node_msodotvs",
      "text": "Native managed graph_* tools\nAI creates/updates nodes, tags, colors, wires, layout, and Save/Reload by operating on the managed backend live graph instance through core services.",
      "tags": [
        "ai",
        "current-system",
        "live-instance",
        "tools"
      ],
      "layout": {
        "position": {
          "x": -576,
          "y": -644
        }
      }
    },
    {
      "id": "node_msodp7k2",
      "text": "Explicit Save boundary\nSave synchronizes visible editor changes into the live graph instance, then commits that instance to the saved JSON resource on disk.",
      "tags": [
        "current-system",
        "editor",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -128.68481599607497,
          "y": 22.107519437155133
        }
      }
    },
    {
      "id": "node_msodpc1x",
      "text": "Reload boundary\nReload replaces the backend live graph instance from disk, clears local pending overlay, and refreshes the visible editor projection immediately.",
      "tags": [
        "current-system",
        "editor",
        "reload",
        "sync"
      ],
      "layout": {
        "position": {
          "x": -137.46144453705256,
          "y": 246.0159991261085
        }
      }
    },
    {
      "id": "node_msodq6qn",
      "text": "Human manual edits\nCanvas edits, inline text, tags, wire controls, panels, and commands update the UI immediately and sync to the backend live graph instance.",
      "tags": [
        "current-system",
        "editor",
        "entrypoint",
        "live-instance"
      ],
      "layout": {
        "position": {
          "x": -1252,
          "y": 80
        }
      }
    }
