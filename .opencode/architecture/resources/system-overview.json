    {
      "id": "migration-finished-state",
      "text": "Finished state achieved — no normal graph edit path writes .opencode/architecture/resources/*.json directly. Saved JSON is durable output of Save/commit, not the live editing surface.",
      "tags": [
        "implemented",
        "migration",
        "verified"
      ],
      "layout": {
        "position": {
          "x": 4,
          "y": 2060
        }
      }
    },
    {
      "id": "migration-goal-commit-only",
      "text": "Migration goal achieved — ordinary graph edits go to the live draft first. The saved JSON file is written by explicit commit/save or lifecycle operations such as create/remove/reset.",
      "tags": [
        "core",
        "implemented",
        "migration",
        "storage",
        "verified"
      ],
      "layout": {
        "position": {
          "x": 4,
          "y": 1400
        }
      }
    },
    {
      "id": "migration-implementation-complete",
      "text": "Implementation complete — legacy saved patch tooling has been discarded; Graph editor and graph tools now fully rely on live draft mutation plus explicit Save/commit persistence.",
      "tags": [
        "cleanup",
        "implemented",
        "migration",
        "verified"
      ],
      "layout": {
        "position": {
          "x": 420,
          "y": 2420
        }
      }
    },
    {
      "id": "migration-old-direct-patch",
      "text": "Removed legacy direct saved patch — ArchitectureGraph.patch, the public saved patch route, patchResource client method, and dead app helper are gone. Normal graph mutations no longer write saved JSON immediately.",
      "tags": [
        "backend",
        "cleanup",
        "implemented",
        "migration",
        "storage",
        "verified"
      ],
      "layout": {
        "position": {
          "x": 4,
          "y": 1240
        }
      }
    },
    {
      "id": "migration-save-tool-added",
      "text": "Save tool added — graph_save_resource commits the current live draft through commitDraft and returns saved:true; if no live draft exists it no-ops with saved:false. This is the explicit AI/chat Save boundary and does not reintroduce direct saved JSON patching.",
      "tags": [
        "implemented",
        "migration",
        "storage",
        "tools",
        "verified"
      ],
      "layout": {
        "position": {
          "x": 760,
          "y": 2420
        }
      }
    },
    {
      "id": "migration-step-1-inventory",
      "text": "Done: inventoried old callers — ArchitectureGraph.patch, the public saved PATCH resource route, generated patchResource clients, dead app helper, tests, and mocks were identified.",
      "tags": [
        "backend",
        "implemented",
        "migration",
        "verified"
      ],
      "layout": {
        "position": {
          "x": -560,
          "y": 1540
        }
      }
    },
    {
      "id": "migration-step-2-route-switch",
      "text": "Done: product callers already used live draft paths; remaining latent surfaces were removed. Editor/API/tool mutations now stay on patchDraft/patchLive before Save.",
      "tags": [
        "backend",
        "frontend",
        "implemented",
        "migration",
        "tools",
        "verified"
      ],
      "layout": {
        "position": {
          "x": -280,
          "y": 1700
        }
      }
    },
    {
      "id": "migration-step-3-api-contract",
      "text": "Done: API contract now removes the direct saved patch route instead of silently changing its semantics. Clients were regenerated after the Protocol/HttpApi change.",
      "tags": [
        "backend",
        "implemented",
        "migration",
        "verified"
      ],
      "layout": {
        "position": {
          "x": 280,
          "y": 1700
