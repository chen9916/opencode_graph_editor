        "position": {
          "x": -360,
          "y": 540
        }
      }
    },
    {
      "id": "live-reload-discard",
      "text": "Reload/discard — drops unsaved RAM changes and returns to the saved disk version.",
      "tags": [
        "core",
        "storage"
      ],
      "layout": {
        "position": {
          "x": 360,
          "y": 700
        }
      }
    },
    {
      "id": "live-save-commit",
