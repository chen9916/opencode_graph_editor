  "nodes": [
    {
      "id": "app-entry",
      "text": "Web entry\n`src/entry.tsx` resolves locale, auth, server URL, and mounts the Solid application at `#root`.",
      "tags": [
        "boundary",
        "current",
        "entry"
      ],
      "layout": {
        "position": {
          "x": -360,
          "y": 0
        }
      }
    },
    {
      "id": "app-interface",
      "text": "Application interface\n`AppInterface` owns server registry, global state, settings, connection/health gates, router, tabs, permissions, and notifications.",
      "tags": [
        "current",
        "provider",
        "routing",
        "state"
      ],
      "layout": {
        "position": {
          "x": -360,
          "y": 440
        }
      }
    },
    {
      "id": "app-providers",
      "text": "Application providers\n`src/app.tsx` composes platform, theme/i18n, error, query, WSL, dialog, file-rendering, command, highlight, and server-scoped providers.",
      "tags": [
        "current",
        "provider",
        "state"
      ],
      "layout": {
        "position": {
          "x": -360,
          "y": 220
        }
      }
    },
    {
      "id": "architecture-controller",
      "text": "Graph panel controller\n`ArchitecturePanel` loads resources, owns resource selection, local draft journal, viewport, and editor lifecycle.",
      "tags": [
        "current",
        "graph",
        "panel",
        "state"
      ],
      "layout": {
        "position": {
          "x": 1440,
          "y": 220
        }
      }
    },
    {
      "id": "capability-visibility",
      "text": "Capability-based visibility\nAuthenticated architecture-route probing gates Graph tabs, header actions, commands, and resource queries.",
      "tags": [
        "boundary",
        "capability",
        "current"
      ],
      "layout": {
        "position": {
          "x": -360,
          "y": 760
        }
      }
    },
    {
      "id": "change-guardrails",
      "text": "Change guardrails\nPreserve capability gating, lazy loading, durable draft journaling, explicit Graph resource semantics, mobile full-content behavior, and RTL-aware layout.",
      "tags": [
        "boundary",
        "guardrail",
        "persistence",
        "planned",
        "rtl"
      ],
      "layout": {
        "position": {
          "x": 1080,
          "y": 980
        }
      }
    },
    {
      "id": "change-surface",
      "text": "Upcoming change surface\nReview session shell, side-panel coupling, new-chat entry, mobile Graph access, and command/header affordances before changing editor internals.",
      "tags": [
        "hotspot",
        "navigation",
        "panel",
        "planned",
        "session"
      ],
      "layout": {
        "position": {
          "x": 720,
          "y": 980
        }
      }
    },
    {
      "id": "chat-surface",
      "text": "Chat surface\nTimeline/message rendering and session detail occupy the primary workspace area.",
      "tags": [
        "content",
        "current",
        "session"
      ],
      "layout": {
        "position": {
          "x": 720,
          "y": 160
        }
      }
    },
    {
      "id": "commands-dialogs",
      "text": "Commands and dialogs\nCommand context, command palette, shared dialogs, permissions, notifications, and settings provide cross-surface actions and feedback.",
      "tags": [
        "commands",
        "current",
        "feature"
      ],
      "layout": {
        "position": {
          "x": 360,
          "y": 980
        }
      }
    },
    {
      "id": "composer",
      "text": "Composer\nPrompt input and follow-up actions belong to the chat region; mobile hides it when a full-content tab is active.",
      "tags": [
        "current",
        "input",
        "session"
      ],
      "layout": {
        "position": {
          "x": 720,
          "y": 360
        }
      }
    },
    {
      "id": "directory-scope",
      "text": "Directory-scoped workspace\n`DirectoryDataProvider` normalizes directory routes, binds `session-ui`, syncs/pins the active session, and provides the local feature context.",
      "tags": [
        "current",
        "directory",
        "state"
      ],
      "layout": {
        "position": {
          "x": 360,
          "y": 740
        }
      }
    },
    {
      "id": "feature-surfaces",
      "text": "Feature surfaces\nPrompt/model choice, timeline and AI output, files/review, terminal/PTY, permissions/questions, notifications, and architecture Graph compose the session workspace.",
      "tags": [
        "content",
        "current",
        "feature",
        "session"
      ],
      "layout": {
        "position": {
          "x": 1080,
          "y": 740
        }
      }
    },
    {
      "id": "graph-editor",
      "text": "Graph editor island\n`ArchitectureIsland` lazy-loads React/React Flow; `ArchitectureEditor` owns canvas nodes/edges, selection, filters, inspector, menus, routing, and undo/redo.",
      "tags": [
        "boundary",
        "content",
        "current",
        "graph"
      ],
      "layout": {
        "position": {
          "x": 1800,
          "y": 220
        }
      }
    },
    {
      "id": "mobile-layout",
      "text": "Mobile layout\nSession content tabs expose chat, changes, and Graph; Graph can render full height with the composer hidden.",
      "tags": [
        "current",
        "hotspot",
        "mobile",
        "session"
      ],
      "layout": {
        "position": {
          "x": 1080,
          "y": 500
        }
      }
    },
    {
      "id": "persistence",
      "text": "Persistence and recovery\nGraph drafts are journaled continuously; resource save/reload and conflict-aware rebase preserve work without a renderer unload blocker.",
      "tags": [
        "current",
        "graph",
        "persistence",
        "state"
      ],
      "layout": {
        "position": {
          "x": 1440,
          "y": 760
        }
      }
    },
    {
      "id": "routing-tabs",
      "text": "Routing and tabs\nRoutes cover home, directory/session, server-targeted session, and new-session drafts; persisted tabs support ordering, recent tabs, and closed-tab recovery.",
      "tags": [
        "current",
        "navigation",
        "routing"
      ],
      "layout": {
        "position": {
          "x": 0,
          "y": 500
        }
      }
    },
    {
      "id": "rtl-i18n",
      "text": "RTL and responsive rules\nLayout and controls respect direction/mobile props; graph geometry stays LTR for stable coordinates and mixed-direction IDs remain readable.",
      "tags": [
        "boundary",
        "guardrail",
        "mobile",
        "rtl"
      ],
      "layout": {
        "position": {
          "x": 1800,
          "y": 760
        }
      }
    },
    {
      "id": "server-boundary",
      "text": "Server/data boundary\nArchitecture API wrappers use generated client routes; events reconcile resource and draft changes with the app cache.",
      "tags": [
        "boundary",
        "current",
        "data"
      ],
      "layout": {
        "position": {
          "x": 1800,
          "y": 520
        }
      }
    },
    {
      "id": "server-data",
      "text": "Server and directory data\n`ServerProvider`, `ServerSDK`, `ServerSync`, `SDKProvider`, and `QueryClientProvider` synchronize server-scoped resources and live events.",
      "tags": [
        "current",
        "data",
        "provider"
      ],
      "layout": {
        "position": {
          "x": 0,
          "y": 740
        }
      }
    },
    {
      "id": "session-navigation",
      "text": "Session navigation\nHeader actions, session tabs, and command palette actions open or switch session surfaces.",
      "tags": [
        "current",
        "hotspot",
        "navigation",
        "session"
      ],
      "layout": {
        "position": {
          "x": 360,
          "y": 500
        }
      }
    },
    {
      "id": "session-providers",
      "text": "Session providers\n`SessionPage` installs Terminal, File, Prompt, and Comments providers around the session surface; session identity is server + directory scoped.",
      "tags": [
        "current",
        "provider",
        "session"
      ],
      "layout": {
        "position": {
          "x": 720,
          "y": 740
        }
      }
    },
    {
      "id": "session-workspace",
      "text": "Session workspace\n`packages/app/src/pages/session.tsx` coordinates desktop/mobile layout, active tabs, side-panel state, and the chat workspace.",
      "tags": [
        "content",
        "current",
        "hotspot",
        "session"
      ],
      "layout": {
        "position": {
          "x": 360,
          "y": 220
        }
      }
    },
    {
      "id": "settings-layout",
      "text": "Settings and layout state\nSettings persist UI, appearance, keybind, notification, sound, permission, and new/legacy layout preferences; layout state persists sidebars, trees, review, terminal, tabs, panels, and scroll.",
      "tags": [
        "current",
        "settings",
        "state"
      ],
      "layout": {
        "position": {
          "x": 0,
          "y": 980
        }
      }
    },
    {
      "id": "side-panel",
      "text": "Desktop side panel\n`SessionSidePanel` hosts Context, Review/File, and Graph tabs; Graph uses the detail/review panel shell.",
      "tags": [
        "current",
        "desktop",
        "hotspot",
        "panel"
      ],
      "layout": {
        "position": {
          "x": 1080,
          "y": 220
        }
      }
    },
    {
      "id": "ui-state",
      "text": "UI state and commands\nLocal session layout state plus editor selection, filters, viewport, undo/redo, and command events coordinate interactions.",
      "tags": [
        "current",
        "graph",
        "navigation",
        "state"
      ],
      "layout": {
        "position": {
          "x": 1440,
          "y": 520
        }
      }
    },
    {
      "id": "ui-system",
      "text": "UI System — current structure and planned change surface",
      "tags": [
        "current",
        "planned",
        "system"
      ],
      "layout": {
        "position": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": "window-shell",
      "text": "Window shell\nTabsProvider and titlebar own open session/draft tabs; Graph is a session-side-panel surface, not a window-level tab.",
